# Include package assets
include AgentCrew/assets/agentcrew_logo.png
recursive-include AgentCrew/modules/gui/themes *.yaml

# Include documentation
include README.md
include LICENSE
include CONTRIBUTING.md

# Include configuration examples
exclude examples/**/*
exclude mcp_servers.json.example

exclude tests/**/*

# Include any other important files
graft AgentCrew/modules
recursive-include AgentCrew/modules/a2a/web *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
recursive-exclude * .pytest_cache
recursive-exclude * .coverage*
